---
source: crates/etd-core-easytier/tests/plan_snapshots.rs
expression: render(&plan)
---
command:
  exe: <CORE>
  arg: -c
  arg: <RUN>/config.toml
  arg: --rpc-portal
  arg: 127.0.0.1:15999
  arg: --rpc-portal-whitelist
  arg: 127.0.0.1/32
  arg: --disable-env-parsing
  arg: --console-log-level
  arg: info
  arg: --file-log-dir
  arg: <RUN>
  cwd: <RUN>
  env: []
file <RUN>/config.toml:
instance_name = "etd-3f9a1c2e-5b7d-4e21-9c4a-7d2f8e1b6a90"
instance_id = "3f9a1c2e-5b7d-4e21-9c4a-7d2f8e1b6a90"
hostname = "bench-01"
ipv4 = "10.126.126.1/24"
listeners = ["tcp://0.0.0.0:21010", "quic://0.0.0.0:21012"]
exit_nodes = ["10.126.126.9"]
socks5_proxy = "socks5://0.0.0.0:1080"

[network_identity]
network_name = "lab"
network_secret = '<SECRET>'

[[peer]]
uri = "udp://198.51.100.7:11010"

[[peer]]
uri = "wss://relay.example.org:443/et"

[[peer]]
uri = "txt://et.example.org"

[[proxy_network]]
cidr = "192.168.10.0/24"

[[proxy_network]]
cidr = "172.16.0.0/12"

[[port_forward]]
bind_addr = "0.0.0.0:8080"
dst_addr = "10.126.126.5:80"
proto = "tcp"

[[port_forward]]
bind_addr = "127.0.0.1:5353"
dst_addr = "10.126.126.5:53"
proto = "udp"

[flags]
dev_name = "etd-e58b9f57"
mtu = 1300
no_tun = false
latency_first = true
enable_encryption = true
enable_ipv6 = false
enable_exit_node = true
use_smoltcp = true
disable_p2p = false
relay_all_peer_rpc = true
disable_udp_hole_punching = true
multi_thread = true
bind_device = true
enable_kcp_proxy = true
enable_quic_proxy = true
accept_dns = false
private_mode = true
data_compress_algo = "Zstd"
